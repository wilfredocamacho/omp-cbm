{
  "name": "omp-cbm",
  "version": "2.0.1",
  "type": "module",
  "description": "Oh My Pi extension that exposes `codebase-memory-mcp` as native tools, with auto-indexing and output shaping tuned for agent workflows and token saving.",
  "main": "./src/index.ts",
  "files": [
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "omp-plugin",
    "codebase-memory",
    "code-intelligence"
  ],
  "license": "MIT",
  "omp": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck",
    "prepack": "npm run check"
  },
  "devDependencies": {
    "@oh-my-pi/pi-ai": "^19.2.1",
    "@oh-my-pi/pi-coding-agent": "^19.2.1",
    "@oh-my-pi/pi-tui": "^19.2.1",
    "@types/node": "^25.9.1",
    "typebox": "^1.4.7",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-ai": "*",
    "@oh-my-pi/pi-coding-agent": "*",
    "@oh-my-pi/pi-tui": "*",
    "typebox": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wilfredocamacho/omp-cbm.git"
  },
  "bugs": {
    "url": "https://github.com/wilfredocamacho/omp-cbm/issues"
  },
  "homepage": "https://github.com/wilfredocamacho/omp-cbm#readme"
}
